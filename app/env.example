# Vercel injects this header value on cron calls; generate a long random string
CRON_SECRET=

# Supabase (server only: never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets: the "Weekly prescription request to be sent to queue" sheet.
# Share the sheet (Editor) with the service account's email address.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Behavior
BUSINESS_TIMEZONE=America/New_York
# Stays in dry-run (no write actions) unless this is exactly "false"
DRY_RUN=true
# Optional override once the SOP's APPROVED / CANCELED question is settled
# KEEP_STATUSES=REJECTED,REQUESTED_FORWARDED,PENDING_MEDICAL_INFORMATION

# Send-back endpoint (build in your app; leave empty to only write the sheet)
SEND_BACK_URL=
SEND_BACK_TOKEN=

# Looker (refill audit)
LOOKER_BASE_URL=
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
LOOKER_LOOK_ID=
